/**
 * Core Philosophy: This ruleset implements a role-based security model with two primary roles: "Publishers" and "Admins".
 * Admins have broad permissions to manage the system, while Publishers are restricted to managing their own profile data.
 *
 * Data Structure:
 * - /publishers/{publisherId}: Stores individual publisher profiles. Access is primarily controlled by ownership, where the document ID matches the user's Auth UID.
 * - /roles_admin/{uid}: A dedicated collection for managing administrator privileges. The existence of a document for a user's UID in this collection grants them admin rights system-wide.
 *
 * Key Security Decisions:
 * - Admin Role Check: Admin status is efficiently determined by checking for the existence of a document in `/roles_admin/{request.auth.uid}`. The ability to create new admins is restricted to a single superuser.
 * - Publisher Privacy: Listing all publishers is a privileged operation restricted to Admins to prevent data scraping and protect user privacy.
 * - Ownership Enforcement: A user can only access data under a path that matches their user ID (e.g., a publisher can only access `/publishers/{their-own-uid}`).
 * - Publisher Self-Creation: Any authenticated user can create their own publisher profile, which is essential for the public registration flow.
 * - Default Secure: Access is denied by default. All permissions must be explicitly granted.
 *
 * Denormalization for Authorization:
 * The `/roles_admin` collection is a prime example of denormalization for authorization. Instead of storing a role property on a user document (which would require a `get()` call in every rule), we use a separate collection. This allows for a highly performant `exists()` check to determine admin status, making the entire ruleset faster and more scalable.
 *
 * Structural Segregation:
 * The data is segregated by function and security level into distinct top-level collections (`/publishers` and `/roles_admin`). This clear separation ensures that security rules for one type of data do not inadvertently affect another.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user has an admin role.
     * Admin status is granted if a document with the user's UID exists in the roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    /**
     * Checks if the user is the designated super admin.
     */
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'vallecondo@gmail.com';
    }

    /**
     * Checks if there are no admins in the system yet.
     * This is used to allow the very first admin to be created.
     */
    function noAdminsExist() {
      // Use `get` on a non-existent path which is cheaper than `exists` on a collection.
      return get(/databases/$(database)/documents/roles_admin/__non_existent_doc__) == null;
    }

    /**
     * Checks if the requesting user's UID matches the provided userId.
     * This is the foundation of the document ownership model.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    /**
     * Verifies that a document already exists.
     * CRITICAL for all update and delete operations to prevent acting on non-existent data.
     */
    function isExistingDoc() {
      return resource != null;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    /**
     * @description Manages publisher profiles. Publishers can read/update their own profile. Admins have full CRUD access.
     * @path /publishers/{publisherId}
     */
    match /publishers/{publisherId} {
      // Allow read and write if user is owner OR is admin
      allow read, write: if isSignedIn() && (isOwner(publisherId) || isAdmin());
      // Allow list only for admins
      allow list: if isAdmin();
      // Allow creation for any signed-in user for their own document
      allow create: if isSignedIn() && isOwner(publisherId);
      // Allow deletion only for super admins or admins
      allow delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Manages admin roles. Existence of a document here grants admin privileges.
     * @path /roles_admin/{adminId}
     */
    match /roles_admin/{adminId} {
      // Allow read and write only for admins
      allow read, write: if isAdmin();
      // Allow the first admin to be created by themselves, or subsequent admins by the super admin.
      allow create: if isSignedIn() && ( (noAdminsExist() && isOwner(adminId)) || isSuperAdmin() );
      // Allow list, update, delete only for super admins
      allow list, update, delete: if isSuperAdmin();
    }
  }
}
