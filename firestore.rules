/**
 * Core Philosophy: This ruleset implements a role-based security model with two primary roles: "Publishers" and "Admins".
 * Admins have broad permissions to manage the system, while Publishers are restricted to managing their own profile and related data.
 *
 * Data Structure:
 * - /publishers/{publisherId}: Stores individual publisher profiles. Access is controlled by ownership, where the document ID matches the user's Auth UID.
 * - /roles_admin/{uid}: A dedicated collection for managing administrator privileges. The existence of a document for a user's UID grants them admin rights.
 * - /offers/{offerId}: Stores promotional offers. Admins manage them, while all authenticated users can read them.
 * - /leads/{leadId}: Stores records of generated leads. Admins have full control, while Publishers can only read their own lead records.
 * - /settings/{settingId}: Stores global company settings. Publicly readable, admin writable.
 * - /payments/{paymentId}: Stores payment records for publishers. Admins have full control, publishers can only read their own paid records.
 *
 * Key Security Decisions:
 * - Admin Role Check: Admin status is efficiently determined by checking for the existence of a document in `/roles_admin/{request.auth.uid}`.
 * - Publisher Privacy: Listing all publishers is a privileged operation restricted to Admins to prevent data scraping.
 * - Ownership Enforcement: A user's access to their own data is enforced by checking if `request.auth.uid` matches the document ID or a `publisherId` field.
 * - Publisher Self-Creation: Any authenticated user can create their own publisher profile.
 * - Default Secure: Access is denied by default. All permissions must be explicitly granted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user has an admin role.
     * Admin status is granted if a document with the user's UID exists in the roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    /**
     * Checks if the requesting user's UID matches the provided userId.
     * This is the foundation of the document ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    /**
     * @description Manages publisher profiles. Publishers can create, read, and update their own profile. Admins have full CRUD access.
     * @path /publishers/{publisherId}
     */
    match /publishers/{publisherId} {
      allow create, read: if isOwner(publisherId);
      allow write: if isAdmin() || isOwner(publisherId);
      allow list: if isAdmin();
    }

    /**
     * @description Manages admin roles. Only existing admins can manage roles. The super admin has special privileges.
     * @path /roles_admin/{uid}
     */
    match /roles_admin/{uid} {
      function isSuperAdmin() {
        return request.auth.token.email == 'vallecondo@gmail.com';
      }
      // Allow read for any signed-in user for role verification purposes (prevents admins logging into publisher portal).
      allow get: if isSignedIn(); 
      // Allow full write access to other admins or the super admin.
      allow write: if isAdmin() || isSuperAdmin();
      // Allow creation only by the super admin.
      allow create: if isSuperAdmin();
      // Allow deletion only by the super admin, but they cannot delete themselves.
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
      // Listing admins is a highly privileged operation.
      allow list: if isSuperAdmin();
    }

    /**
     * @description Manages promotional offers. Admins have full write access. All authenticated users can read.
     * @path /offers/{offerId}
     */
    match /offers/{offerId} {
      allow write: if isAdmin();
      allow read: if isSignedIn();
    }

    /**
     * @description Manages lead records. Admins have full control. Publishers can only read their own records.
     * @path /leads/{leadId}
     */
    match /leads/{leadId} {
      allow write: if isAdmin();
      // A publisher can only read a lead document if the publisherId in the document matches their own UID.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.publisherId);
      // Listing is restricted to admins or publishers querying their own leads.
      allow list: if isAdmin() || (isSignedIn() && request.query.where[0][2] == request.auth.uid);
    }
    
    /**
     * @description Manages global company settings. Publicly readable, admin writable.
     * @path /settings/{settingId}
     */
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Manages payment records. Admins have full control. Publishers can read their own paid records.
     * @path /payments/{paymentId}
     */
    match /payments/{paymentId} {
      allow write: if isAdmin();
      // A publisher can only read a payment document if it belongs to them and its status is 'paid'.
      allow read: if isAdmin() || (isSignedIn() && isOwner(resource.data.publisherId) && resource.data.status == 'paid');
      // Publishers can list their own payments.
      allow list: if isAdmin() || (isSignedIn() && request.query.where[0][2] == request.auth.uid);
    }
  }
}
