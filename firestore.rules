rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------

    // Publishers
    match /publishers/{publisherId} {
      // Admins pueden todo
      allow read, write, list: if isAdmin();

      // Publishers pueden crear su propio perfil
      allow create: if isOwner(publisherId);

      // Publishers pueden leer y actualizar solo su propio perfil
      allow read, update: if isOwner(publisherId);

      // Permitir list a cualquier usuario autenticado (read filtra lo visible)
      allow list: if isAdmin() || isSignedIn();
    }

    // Admin roles
    match /roles_admin/{uid} {
      function isSuperAdmin() {
        return request.auth.token.email == 'vallecondo@gmail.com';
      }
      allow get: if isSignedIn(); 
      allow write: if isAdmin() || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
      allow list: if isSuperAdmin();
    }

    // Offers
    match /offers/{offerId} {
      allow write: if isAdmin();
      allow read, list: if isSignedIn();
    }

    // Leads Manuales
    match /leads/{leadId} {
      allow write: if isAdmin();
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.publisherId);
      allow list: if isAdmin() || isSignedIn();
    }

    // Leads Automatizados (Webhooks Monitor)
    match /leads_automated/{leadId} {
      allow read, write, list: if isAdmin();
      // Los trabajadores pueden ver sus propias conversiones automatizadas
      allow read: if isSignedIn() && request.auth.uid == resource.data.publisherId;
    }
    
    // Settings
    match /settings/{settingId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      // Admins pueden todo
      allow read, write, list: if isAdmin();

      // Publishers pueden leer solo sus propios pagos
      allow read: if isSignedIn() && request.auth.uid == resource.data.publisherId;

      // Publishers pueden listar, pero solo verán sus propios documentos gracias al read
      allow list: if isAdmin() || isSignedIn();
    }
  }
}