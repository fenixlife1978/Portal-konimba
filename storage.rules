rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rules for logos
    match /logos/{logoId} {
      // Allow read access to everyone for logos
      allow read: if true;
      
      // Allow write access only to authenticated users who have an admin role document in Firestore.
      allow write: if request.auth != null && 
                   exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
